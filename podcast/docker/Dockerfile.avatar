# Avatar worker — MuseTalk. Weights are mounted at runtime rather than baked in,
# so the image stays small and the models survive a rebuild.
#
# EVERYTHING HERE IS PINNED, AND IT HAS TO BE.
#
# The unpinned version of this file caused, in order: a SIGSEGV importing
# mmcv.ops on torch 2.6; every mm* checkpoint refusing to load after torch 2.6
# flipped torch.load's weights_only default; and finally a build that stopped
# working entirely when pip fell back to the mmcv source tarball. The running
# images could not be recreated from either recipe.
#
# It was also blamed for a 27% throughput gap between the two avatar nodes.
# That was wrong -- the nodes are the same speed, and the gap was an artefact of
# comparing unequal batches. Pinning is worth doing for reproducibility, not for
# performance. Nothing here will make a render faster.
#
# The versions below are not reasoned about. They are `pip freeze` from the
# images running on node-b and node-c today, which render correctly and are
# byte-identical to each other. An earlier attempt at this file picked a set that
# was defensible on paper -- torch 2.1 because that is what mmcv 2.1.0 publishes
# a wheel for -- and cost three failed builds without ever being run.
#
# One consequence to be honest about: mmcv 2.1.0 has no wheel built for torch
# 2.6, so what is installed here is the cu121/torch2.1 binary running against
# torch 2.6. That mismatch is why the compose files set PYTORCH_JIT=0 and
# TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1. It is not elegant, it is what works, and
# pinning it means it keeps working rather than breaking on the next rebuild.
#
# Rebuild BOTH avatar nodes on any change here. Two nodes on different versions
# is what this pinning exists to prevent.
FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3.11-dev python3-pip \
      ffmpeg git build-essential libgl1 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*

# Applied to EVERY pip install below, including MuseTalk's requirements.txt.
# Pinning in the Dockerfile alone was not enough: requirements.txt runs after
# our pins and pulled in an OpenCV built against the numpy 2.x ABI, which then
# failed to import against the numpy 1.x that mmcv needs. A constraints file is
# the only thing that reaches installs we do not write.
COPY docker/constraints.avatar.txt /etc/pip-constraints.txt
ENV PIP_CONSTRAINT=/etc/pip-constraints.txt

RUN python3.11 -m pip install --no-cache-dir "pip==24.2" "setuptools==69.5.1" "wheel"

RUN python3.11 -m pip install --no-cache-dir \
      torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 \
      --index-url https://download.pytorch.org/whl/cu124

# MuseTalk itself moves. Pin MUSETALK_REF to a commit once a build is known good
# -- `docker build --build-arg MUSETALK_REF=<sha>` -- or this clone silently
# changes which code renders the show every time the image is rebuilt. The build
# prints the SHA it landed on so there is something to pin to.
ARG MUSETALK_REF=main
RUN git clone https://github.com/TMElyralab/MuseTalk /opt/MuseTalk \
    && cd /opt/MuseTalk \
    && git checkout "${MUSETALK_REF}" \
    && echo "MuseTalk commit: $(git rev-parse HEAD)" | tee /opt/MuseTalk/COMMIT.txt

RUN python3.11 -m pip install --no-cache-dir -r /opt/MuseTalk/requirements.txt

# mmcv from OpenMMLab's wheel index -- never PyPI, which has no wheel for this
# and would compile from source, where setup.py imports the pkg_resources that
# setuptools 81 removed.
#
# The cu121/torch2.1.0 index is deliberate even though torch here is 2.6: there
# is no torch 2.6 index, and this is the binary the working images contain. The
# ABI mismatch is real and is what the PYTORCH_JIT=0 workaround exists for.
#
# Plain pip rather than openmim: openmim pulls in openxlab, which pins
# setuptools~=60.2, requests 2.28 and pytz 2023.4, downgrading half the image.
RUN python3.11 -m pip install --no-cache-dir "mmengine==0.10.7" \
    && python3.11 -m pip install --no-cache-dir "mmcv==2.1.0" \
       -f https://download.openmmlab.com/mmcv/dist/cu121/torch2.1.0/index.html \
    && python3.11 -m pip install --no-cache-dir "mmdet==3.3.0" "mmpose==1.3.2"

RUN python3.11 -m pip install --no-cache-dir \
      "fastapi==0.115.0" "uvicorn==0.30.6" "pydantic==2.9.2"

# Fail the build rather than the first render. An image that cannot import
# mmcv.ops is useless, and finding that out here costs a minute instead of
# twenty and a confusing exit code on a node.
# PYTORCH_JIT=0 here for the same reason the compose files set it: importing
# mmcv.ops on torch 2.6 segfaults inside the TorchScript compiler. The check
# would otherwise fail on an image that runs perfectly well at runtime.
RUN PYTORCH_JIT=0 python3.11 -c "\
import numpy, cv2, torch, mmcv, mmdet, mmpose; \
from mmcv.ops import nms; \
print('numpy', numpy.__version__, '| cv2', cv2.__version__); \
print('torch', torch.__version__, '| cuda', torch.version.cuda); \
print('mmcv', mmcv.__version__, '| mmdet', mmdet.__version__, '| mmpose', mmpose.__version__); \
print('ALL IMPORTS OK')"

COPY cluster/ /opt/worker/
WORKDIR /opt/worker
EXPOSE 8081
CMD ["python3.11", "avatar_worker.py"]
