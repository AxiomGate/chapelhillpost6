# Voice worker — Chatterbox. Its own image because Chatterbox, MuseTalk and the
# caption stack pin conflicting torch/transformers versions and cannot coexist.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.11 python3.11-venv python3-pip ffmpeg libsndfile1 curl \
    && rm -rf /var/lib/apt/lists/*

RUN python3.11 -m pip install --no-cache-dir --upgrade pip
RUN python3.11 -m pip install --no-cache-dir \
      torch torchaudio --index-url https://download.pytorch.org/whl/cu124
RUN python3.11 -m pip install --no-cache-dir \
      chatterbox-tts fastapi uvicorn pydantic

COPY cluster/ /opt/worker/
WORKDIR /opt/worker
EXPOSE 8080
CMD ["python3.11", "tts_worker.py"]
