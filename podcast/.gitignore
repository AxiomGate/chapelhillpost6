# Secrets — base and per client. Each client has its own YouTube credentials,
# so the glob must cover the client tree too.
.env
config/youtube_client_secret.json
config/youtube_token.json
clients/*/youtube_client_secret.json
clients/*/youtube_token.json
clients/*/.env

# Generated media and state
work/
output/

# Assets are large binaries and personal — a voice reference and a base loop are
# someone's actual voice and likeness. Never commit them, for the shared tree or
# for any client.
assets/voice/*
assets/avatar/*
assets/broll/*
assets/brand/*
clients/*/assets/voice/*
clients/*/assets/avatar/*
clients/*/assets/broll/*
clients/*/assets/brand/*
!**/.gitkeep
!**/README.md

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
