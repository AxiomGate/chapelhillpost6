# Copy to podcast/.env and fill in. .env is gitignored.
# Load it before running: set -a; source .env; set +a

# Scripting and research. Not needed if llm.provider is set to "local".
ANTHROPIC_API_KEY=

# Shown as the podcast owner in the RSS feed. Apple requires a real address.
SHOW_EMAIL=

# Only if your local vLLM server is started with --api-key.
LOCAL_LLM_API_KEY=

# Where the MuseTalk repo is cloned, if not ~/src/MuseTalk.
MUSETALK_HOME=

# Where the LatentSync repo is cloned, if not ~/src/LatentSync.
LATENTSYNC_HOME=
