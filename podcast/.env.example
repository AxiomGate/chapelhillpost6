# Copy to .env next to the compose files. .env is gitignored; this file is not,
# so never put a real key or UUID here.
#
#   cp .env.example .env
#
# Docker Compose reads .env from the directory you run `docker compose` in, so
# each node needs its own copy. A node only needs the variables its own compose
# file references -- an unset variable for a service that node does not run is
# harmless, but an unset variable for one it does run silently expands to an
# empty string, which hands the container *every* GPU on the box. Check with:
#
#   docker compose -f docker-compose.node-b.yml config | grep NVIDIA_VISIBLE

# ---- API keys -------------------------------------------------------------

# Used by the orchestrator on node-a only.
ANTHROPIC_API_KEY=sk-ant-...

# ---- GPU UUIDs ------------------------------------------------------------
#
# UUIDs, never indices. Indices reorder across reboots and after any hardware
# change; a UUID is burned into the card and follows it between machines. When
# you move a card to another host, move its value to the new variable name
# unchanged -- do not look it up again expecting a new number.
#
# On each host:
#   nvidia-smi --query-gpu=index,name,uuid,memory.total --format=csv
#
# Card inventory as of 2026-08-15:
#   node-a  10.10.5.15   1x RTX 3090
#   node-b  10.10.5.16   1x RTX 3090 + 1x RTX A1000   (A1000 came from node-a)
#   node-c  10.10.5.17   1x RTX 3090 + 1x RTX A1000   (A1000 new)

# node-a — voice worker
NODE_A_3090=GPU-00000000-0000-0000-0000-000000000000

# node-b — avatar worker + media worker
NODE_B_3090=GPU-00000000-0000-0000-0000-000000000000
NODE_B_A1000=GPU-00000000-0000-0000-0000-000000000000

# node-c — avatar worker + media worker
NODE_C_3090=GPU-00000000-0000-0000-0000-000000000000
NODE_C_A1000=GPU-00000000-0000-0000-0000-000000000000
